<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MyMod</AssemblyName>
    <RootNamespace>MyMod</RootNamespace>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- BepInEx 5 & Harmony (via NuGet if local BepInEx folder is not present) -->
  <ItemGroup Condition="!Exists('..\BepInEx\core\BepInEx.dll')">
    <PackageReference Include="BepInEx.Core" Version="5.*" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- BepInEx 5 & Harmony (local game folder reference if BepInEx is already extracted) -->
  <ItemGroup Condition="Exists('..\BepInEx\core\BepInEx.dll')">
    <Reference Include="BepInEx">
      <HintPath>..\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game & Unity Managed Assemblies -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\ProjCompleted_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="..\ProjCompleted_Data\Managed\UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

